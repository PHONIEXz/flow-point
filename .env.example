# Set AI_PROVIDER=groq to use Groq; Groq is also selected when GROQ_API_KEY exists.
# Server only. Never commit real keys. Google and Groq keys are not interchangeable.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional Google adapter (set AI_PROVIDER=google):
# Server only. Never place this key in public/ or commit .env.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=3000
